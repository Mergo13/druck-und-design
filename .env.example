NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://www.example.at

# Security and administrator access
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=admin@example.at

# LibSQL/Turso database; use file:./dev.db only for local development
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=replace-me

# Persistent file storage
UPLOAD_STORAGE=vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Payments
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Email
SMTP_HOST=smtp.example.at
SMTP_PORT=587
SMTP_USER=service@example.at
SMTP_PASS=replace-me
SMTP_FROM_EMAIL=service@example.at
CONTACT_NOTIFY_EMAIL=service@example.at
PRODUCT_SELECTION_NOTIFY_EMAIL=service@example.at

# CRM
CRM_API_URL=https://crm.example.at/api/orders
CRM_API_TOKEN=replace-me
CRM_INVOICE_PDF_URL_TEMPLATE=https://dud.ussuri-rudd.ts.net/pages/rechnung_pdf.php?id={invoice_id}
CRM_INVOICE_CANCEL_URL=https://crm.example.at/api/invoices/cancel
CRM_INVOICE_DELETE_URL=https://crm.example.at/api/invoices/delete

# Shipping
SENDCLOUD_PUBLIC_KEY=replace-me
SENDCLOUD_SECRET_KEY=replace-me
SENDCLOUD_FROM_COUNTRY=AT

# Optional infrastructure
REDIS_URL=
NATS_URL=
